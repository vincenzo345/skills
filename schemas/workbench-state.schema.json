{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.local/schemas/v1/workbench-state.schema.json",
  "title": "Workbench State",
  "description": "The current file-backed control-plane state for one work item. Current stage membership, legal transitions, and reference existence require runtime validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "state_revision",
    "work_id",
    "title",
    "desired_outcome",
    "planning_destination",
    "route_selection",
    "current_stage",
    "stages",
    "map_id",
    "owner",
    "status",
    "created_at",
    "updated_at",
    "artifact_ids",
    "decision_ids",
    "proof_ids",
    "authorization_ids",
    "handoff_ids"
  ],
  "properties": {
    "record_type": {
      "const": "workbench-state"
    },
    "schema_version": {
      "$ref": "workbench-common.schema.json#/$defs/semanticVersion"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1
    },
    "work_id": {
      "$ref": "workbench-common.schema.json#/$defs/workId"
    },
    "title": {
      "$ref": "workbench-common.schema.json#/$defs/shortString"
    },
    "desired_outcome": {
      "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
    },
    "planning_destination": {
      "$ref": "workbench-common.schema.json#/$defs/planningDestination"
    },
    "route_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "rationale",
        "selected_by",
        "selected_at"
      ],
      "properties": {
        "route": {
          "oneOf": [
            {"$ref": "workbench-common.schema.json#/$defs/routeKind"},
            {"const": "profile-compiled"}
          ]
        },
        "rationale": {
          "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
        },
        "selected_by": {
          "$ref": "workbench-common.schema.json#/$defs/actorRef"
        },
        "selected_at": {
          "$ref": "workbench-common.schema.json#/$defs/timestamp"
        }
      }
    },
    "current_stage": {
      "$ref": "workbench-common.schema.json#/$defs/stageId"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stageState"
      }
    },
    "map_id": {
      "$ref": "workbench-common.schema.json#/$defs/mapId"
    },
    "owner": {
      "$ref": "workbench-common.schema.json#/$defs/actorRef"
    },
    "status": {
      "$ref": "workbench-lifecycle.schema.json#/$defs/workStatus"
    },
    "next_action": {
      "$ref": "workbench-common.schema.json#/$defs/nextAction"
    },
    "stop_reason": {
      "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
    },
    "completion": {
      "$ref": "#/$defs/completion"
    },
    "latest_event_id": {
      "$ref": "workbench-common.schema.json#/$defs/eventId"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/artifactId"
      },
      "uniqueItems": true
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/decisionId"
      },
      "uniqueItems": true
    },
    "proof_ids": {
      "type": "array",
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/proofId"
      },
      "uniqueItems": true
    },
    "authorization_ids": {
      "type": "array",
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/authorizationId"
      },
      "uniqueItems": true
    },
    "handoff_ids": {
      "type": "array",
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/handoffId"
      },
      "uniqueItems": true
    },
    "created_at": {
      "$ref": "workbench-common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "workbench-common.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "awaiting-acceptance",
              "paused",
              "blocked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "next_action"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "stopped",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "stop_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed-for-destination",
              "completed-for-outcome"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completion"
        ]
      }
    }
  ],
  "$defs": {
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "proof_ids",
        "open_obligation_node_ids",
        "authorized_by",
        "completed_at"
      ],
      "properties": {
        "claim": {
          "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
        },
        "proof_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "workbench-common.schema.json#/$defs/proofId"
          },
          "uniqueItems": true
        },
        "open_obligation_node_ids": {
          "type": "array",
          "items": {
            "$ref": "workbench-common.schema.json#/$defs/nodeId"
          },
          "uniqueItems": true
        },
        "authorized_by": {
          "$ref": "workbench-common.schema.json#/$defs/authorizationId"
        },
        "completed_at": {
          "$ref": "workbench-common.schema.json#/$defs/timestamp"
        }
      }
    },
    "stageState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "applicability",
        "status",
        "owner",
        "applicability_reason"
      ],
      "properties": {
        "stage_id": {
          "$ref": "workbench-common.schema.json#/$defs/stageId"
        },
        "phase_id": {
          "$ref": "workbench-lifecycle.schema.json#/$defs/phaseId"
        },
        "activity_stage_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "workbench-common.schema.json#/$defs/stageId"},
          "uniqueItems": true
        },
        "applicability": {
          "enum": [
            "undetermined",
            "applicable",
            "not-applicable"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "active",
            "blocked",
            "complete",
            "skipped"
          ]
        },
        "owner": {
          "$ref": "workbench-common.schema.json#/$defs/actorRef"
        },
        "applicability_reason": {
          "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
        },
        "skip_consequence": {
          "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
        },
        "next_action": {
          "$ref": "workbench-common.schema.json#/$defs/nextAction"
        },
        "started_at": {
          "$ref": "workbench-common.schema.json#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "workbench-common.schema.json#/$defs/timestamp"
        },
        "output_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "workbench-common.schema.json#/$defs/artifactId"
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "active",
                  "blocked"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "next_action"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "skip_consequence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "completed_at"
            ]
          }
        }
      ]
    }
  }
}
