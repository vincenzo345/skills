{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.local/schemas/v1/workbench-handoff.schema.json",
  "title": "Workbench Specialist Handoff",
  "description": "The common specialist output envelope. A completed handoff is not accepted until a separate transition event records acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "handoff_id",
    "work_id",
    "node_id",
    "stage",
    "specialist",
    "status",
    "owner",
    "idempotency_key",
    "input_fingerprint",
    "inputs_used",
    "applicability",
    "policy_versions",
    "findings",
    "options",
    "decisions_required",
    "artifacts_produced",
    "node_updates",
    "authorization_ids",
    "created_at"
  ],
  "properties": {
    "record_type": {
      "const": "workbench-handoff"
    },
    "schema_version": {
      "$ref": "workbench-common.schema.json#/$defs/semanticVersion"
    },
    "handoff_id": {
      "$ref": "workbench-common.schema.json#/$defs/handoffId"
    },
    "work_id": {
      "$ref": "workbench-common.schema.json#/$defs/workId"
    },
    "node_id": {
      "$ref": "workbench-common.schema.json#/$defs/nodeId"
    },
    "stage": {
      "$ref": "workbench-common.schema.json#/$defs/stageId"
    },
    "specialist": {
      "$ref": "workbench-common.schema.json#/$defs/specialistId"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "decision-required"
      ]
    },
    "owner": {
      "$ref": "workbench-common.schema.json#/$defs/actorRef"
    },
    "next_action": {
      "$ref": "workbench-common.schema.json#/$defs/nextAction"
    },
    "input_fingerprint": {
      "$ref": "workbench-common.schema.json#/$defs/digest"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "inputs_used": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/recordRef"
      },
      "uniqueItems": true
    },
    "applicability": {
      "$ref": "#/$defs/applicability"
    },
    "policy_versions": {
      "$ref": "workbench-common.schema.json#/$defs/policyVersions"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "recommendation": {
      "$ref": "workbench-common.schema.json#/$defs/recommendation"
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "question"
        ],
        "properties": {
          "decision_id": {
            "$ref": "workbench-common.schema.json#/$defs/decisionId"
          },
          "question": {
            "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "artifacts_produced": {
      "type": "array",
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/artifactRef"
      },
      "uniqueItems": true
    },
    "node_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "proposed_status",
          "rationale"
        ],
        "properties": {
          "node_id": {
            "$ref": "workbench-common.schema.json#/$defs/nodeId"
          },
          "proposed_status": {
            "$ref": "workbench-common.schema.json#/$defs/nodeStatus"
          },
          "rationale": {
            "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/blocker"
      }
    },
    "authorization_ids": {
      "type": "array",
      "items": {
        "$ref": "workbench-common.schema.json#/$defs/authorizationId"
      },
      "uniqueItems": true
    },
    "suggested_next_stage": {
      "$ref": "workbench-common.schema.json#/$defs/stageId"
    },
    "terminal_disposition": {
      "$ref": "#/$defs/terminalDisposition"
    },
    "why_next": {
      "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
    },
    "created_at": {
      "$ref": "workbench-common.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "why_next"
        ],
        "oneOf": [
          {
            "required": [
              "suggested_next_stage"
            ]
          },
          {
            "required": [
              "terminal_disposition"
            ]
          }
        ],
        "properties": {
          "artifacts_produced": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "next_action",
          "blockers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "decision-required"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "next_action"
        ],
        "properties": {
          "decisions_required": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "terminalDisposition": {
      "enum": [
        "stopped",
        "completed-for-destination",
        "completed-for-outcome",
        "cancelled"
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "skipped",
        "could_not_determine"
      ],
      "properties": {
        "applied": {
          "type": "array",
          "items": {
            "$ref": "workbench-common.schema.json#/$defs/shortString"
          },
          "uniqueItems": true
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/applicabilityException"
          }
        },
        "could_not_determine": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/applicabilityException"
          }
        }
      }
    },
    "applicabilityException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "reason"
      ],
      "properties": {
        "method_id": {
          "$ref": "workbench-common.schema.json#/$defs/shortString"
        },
        "reason": {
          "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "benefits",
        "costs",
        "risks"
      ],
      "properties": {
        "name": {
          "$ref": "workbench-common.schema.json#/$defs/shortString"
        },
        "benefits": {
          "type": "array",
          "items": {
            "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
          }
        },
        "costs": {
          "type": "array",
          "items": {
            "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "workbench-common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
