{
  "$comment": "Safer than --dangerously-skip-permissions: pre-allow the tools the loop needs, deny destructive shell. Tune the Bash allow-list to your stack's build/test commands.",
  "permissions": {
    "allow": [
      "Read", "Write", "Edit", "Glob", "Grep",
      "Bash(git *)",
      "Bash(ci/*)",
      "Bash(bash ci/*)",
      "Bash(sh ci/*)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "enableAllProjectMcpServers": true
}
